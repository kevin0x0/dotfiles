{{with .Message -}}
  {{. -}}
{{else -}}
  {{.Mode | printf "%s %s \033[0m" (env "lf_user_modefmt") -}}
  {{with .Stat -}}
    {{printf "%s %s \033[0m" (env "lf_user_permfmt") .Permissions -}}
    {{with .LinkCount}}{{printf "%s %s \033[0m" (env "lf_user_linkcountfmt") .}}{{end -}}
    {{with .User}}{{printf "%s %s \033[0m" (env "lf_user_userfmt") .}}{{end -}}
    {{with .Group}}{{printf "%s %s \033[0m" (env "lf_user_groupfmt") .}}{{end -}}
    {{humanize .Size | printf "%s %s \033[0m" (env "lf_user_sizefmt") -}}
    {{printf "%s %s\033[0m" (env "lf_user_modtimefmt") .ModTime -}}
    {{with .Target -}}
      {{ printf " %s -> " (env "lf_user_linkfmt") -}}
      {{. -}}
      {{ " \033[0m" -}}
    {{end -}}
  {{end -}}
{{end -}}

{{.SPACER -}}

{{with .Keys}} {{.}} {{end -}}
{{with .Progress}} {{join . " "}} {{end -}}
{{with .Cut}}{{len . | printf "%s %d \033[0m" $.Options.cutfmt}}{{end -}}
{{with .Copy}}{{len . | printf "%s %d \033[0m" $.Options.copyfmt}}{{end -}}
{{with .Select}}{{len . | printf "%s %d \033[0m" $.Options.selectfmt}}{{end -}}
{{with .Visual}}{{len . | printf "%s %d \033[0m" $.Options.visualfmt}}{{end -}}
{{with .Filter}}{{join . " " | printf "%s %s \033[0m" (env "lf_user_filterfmt")}}{{end -}}
{{printf "%s %d/%d \033[0m" (env "lf_user_iovertfmt") .Index .Total}}
