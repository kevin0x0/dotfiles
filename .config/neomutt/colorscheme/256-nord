# basic colors ---------------------------------------------------------
color error               color167  color236                       # message line error text (bright red)
color tilde               color108  color236                       # vi-like tildes marking blank lines
color message             color108  color236
color markers       bold  color167  color236                       # wrapped-line /^\+/ markers
color attachment    bold  color110  color236                       # attachment headers
color search              color236  color110                       # search patterns in pager
color status        bold  color236  color108
color indicator     bold  color236  color110                       # selected email in index
color tree          bold  color110  color236                       # arrow in threads (`-->')

# basic monochrome screen
mono bold           bold
mono underline      underline
mono indicator      reverse
mono error          bold
mono header         bold                            "^(From|Subject|Date|To|Cc|Bcc):"
mono quoted         bold

# index ----------------------------------------------------------------

color index               color110  color236       "~A"            # all messages
color index               color245  color236       "~E"            # expired messages
color index         bold  color110  color236       "~N"            # new messages
color index               color245  color236       "~O"            # old messages
color index               color245  color236       "~R"            # read messages
color index         bold  color245  color236       "~Q"            # messages that have been replied to
color index         bold  color110  color236       "~U"            # unread messages
color index         bold  color110  color236       "~U~$"          # unread, unreferenced messages
color index               color108  color236       "~v"            # messages part of a collapsed thread
color index               color245  color236       "~P"            # messages from me
#color index               color71   color0        "~p!~F"        # messages to me
#color index               color71   color0        "~N~p!~F"      # new messages to me
#color index               color71   color0        "~U~p!~F"      # unread messages to me
#color index               color244  color0        "~R~p!~F"      # messages to me
color index         bold  color139  color236       "~F"            # flagged messages
color index         bold  color139  color236       "~F~p"          # flagged messages to me
color index         bold  color139  color236       "~N~F"          # new flagged messages
color index         bold  color139  color236       "~N~F~p"        # new flagged messages to me
color index         bold  color139  color236       "~U~F~p"        # new flagged messages to me
color index               color236  color167       "!~N ~D"        # deleted messages
color index               color236  color167       "~N ~D"         # deleted new messages
color index               color245  color236       "~v~(!~N)"      # collapsed thread with no unread
color index               color108  color236       "~v~(~N)"       # collapsed thread with some unread
color index               color108  color236       "~N~v~(~N)"     # collapsed thread with unread parent
# statusbg used to indicated flagged when foreground color shows other status
# for collapsed thread
color index               color108  color236       "~v~(~F)!~N"    # collapsed thread with flagged, no unread
color index               color108  color236       "~v~(~F~N)"     # collapsed thread with some unread & flagged
color index               color108  color236       "~N~v~(~F~N)"   # collapsed thread with unread parent & flagged
color index               color108  color236       "~N~v~(~F)"     # collapsed thread with unread parent, no unread inside, but some flagged
color index               color108  color236       "~v~(~p)"       # collapsed thread with unread parent, no unread inside, some to me directly
color index               color108  color167       "~v~(~D)"       # thread with deleted (doesn't differentiate between all or partial)
color index               color108  color236       "~T"            # tagged messages
color index         bold  color108  color236       "~T~F"          # tagged, flagged messages
color index         bold  color108  color236       "~T~N"          # tagged, new messages
color index         bold  color108  color236       "~T~U"          # tagged, unread messages

# message headers ------------------------------------------------------

color hdrdefault    bold  color173  color236
color header        bold  color108  color236       "^(From|To|Cc|Bcc)"
color header        bold  color108  color236       "^(Subject|Date)"

# body -----------------------------------------------------------------

color quoted              color110  color236
color quoted1             color222  color236
color quoted2             color173  color236
color quoted3             color110  color236
color quoted4             color110  color236
color signature           color108  color236                        # everything below /^--\s*$/

color bold                color253  color236
color underline           color236  color245
color normal              color245  color236

## pgp

color body                color167  color236       "(BAD signature)"
color body                color108  color236       "(Good signature)"
color body                color236  color236       "^gpg: Good signature .*"
color body                color245  color236       "^gpg: "
color body                color245  color167       "^gpg: BAD signature from.*"
mono  body          bold                          "^gpg: Good signature"
mono  body          bold                          "^gpg: BAD signature from.*"

