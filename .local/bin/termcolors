#!/bin/sh

output_colors=
if [ "$COLORTERM" = truecolor ] || [ "$COLORTERM" = 24bit ]; then
  output_colors=16777216
else
  if ! colors=$(tput colors 2>/dev/null); then
    echo none
    exit 0
  fi

  case "$colors" in
    256|88|16|8|2)
      output_colors=$colors
      ;;
    *)
      output_colors=none
      ;;
  esac
fi

printf "%s\n" "$output_colors"
